{
  "name": "frontend",
  "private": true,
  "scripts": {
    "build": "node scripts/generate-env.js && vite build",
    "clean": "rm -rf dist",
    "lint": "npm run clean && eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:tsc": "tsc --noEmit",
    "start": "vite --open",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage --colors"
  },
  "dependencies": {
    "@atlaskit/button": "23.9.6",
    "@atlaskit/css-reset": "7.3.12",
    "@atlaskit/form": "15.3.4",
    "@atlaskit/radio": "^8.4.2",
    "@atlaskit/select": "^21.7.4",
    "@atlaskit/spinner": "19.0.10",
    "@atlaskit/textfield": "8.2.3",
    "@forge/bridge": "5.5.0",
    "echarts": "5.4.2",
    "echarts-for-react": "3.0.2",
    "lodash": "^4.17.21",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node",
      "verbatimModuleSyntax": false
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react-swc": "4.1.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "jest-watch-typeahead": "3.0.1",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.45.0",
    "vite": "^7.1.10"
  }
}
