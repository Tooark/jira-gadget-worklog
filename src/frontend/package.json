{
  "name": "frontend",
  "private": true,
  "scripts": {
    "build": "node scripts/generate-env.js && vite build",
    "clean": "rm -rf dist",
    "lint": "npm run clean && eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:tsc": "tsc --noEmit",
    "start": "vite --open",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage --colors"
  },
  "dependencies": {
    "@atlaskit/button": "24.0.0",
    "@atlaskit/css-reset": "8.0.0",
    "@atlaskit/form": "16.0.0",
    "@atlaskit/radio": "^9.0.0",
    "@atlaskit/select": "^22.0.0",
    "@atlaskit/spinner": "20.0.0",
    "@atlaskit/textfield": "9.0.0",
    "@forge/bridge": "5.5.0",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "lodash": "^4.17.21",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node",
      "verbatimModuleSyntax": false
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.0",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react-swc": "4.3.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-watch-typeahead": "3.0.1",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "^7.3.5"
  }
}
